# Nebius Token Factory. Never commit the real token.
NEBIUS_API_KEY=
NEBIUS_AI_PROJECT_ID=

# Active runtime model. For the submitted build this must be the exact NVIDIA
# Nemotron ID returned by the authenticated GET /v1/models endpoint.
ZEPHYR_ACTIVE_MODEL=

# Final compliance probe. Keep this equal to the Nemotron model used in the
# submitted application.
ZEPHYR_NEMOTRON_MODEL=

# Primary endpoint when ACTIVE_MODEL matches NEMOTRON_MODEL.
# Other active models use BASE_URL_V2 when configured, otherwise BASE_URL.
# Model names and credentials are configured only in the private .env.
ZEPHYR_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
ZEPHYR_TOKEN_FACTORY_BASE_URL_V2=
ZEPHYR_DOMINO_ASSETS_DIR=.local/domino-assets
